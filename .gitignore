# Rendered output is regenerable via lib/gate.sh; do not commit frames/videos.
projects/*/out/
!projects/kit-testbench/out/.gitkeep

# gate.sh copies the generated kit root-relative into each project so
# real HyperFrames renders get root-relative asset paths; regenerated
# every gate run from the canonical lib/motion-kit.js.
projects/*/motion-kit.js

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Assets are provided per deployment, not committed (keep the placeholders).
assets/fonts/*
assets/music/*
assets/heroes/*
!assets/**/README.md
!assets/**/.gitkeep

# Local Python env for Kokoro TTS (HYPERFRAMES_PYTHON)
.venv/
